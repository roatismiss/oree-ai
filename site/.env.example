# Copy to .env.local for local work, and set the same variable in Vercel
# (Project → Settings → Environment Variables) for production.

# Access key for the contact form relay. Issued at https://web3forms.com by
# entering the address the messages should land in — aminata.diabate@oreeconseil.ca.
# The key arrives by email and is tied to that address; it never leaves the server.
# Without it, /api/contact answers 503 and the form falls back to the visitor's
# own mail client.
WEB3FORMS_ACCESS_KEY=
